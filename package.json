{
  "name": "jenkins-ci-interview-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "check": "node --check src/app.js && node --check src/server.js && node --check test/app.test.js && node --check test/junit-to-suite.test.js && node --check scripts/junit-to-suite.js",
    "test": "node --experimental-test-coverage --test --test-coverage-include=src/app.js --test-coverage-lines=100 --test-coverage-branches=95 --test-coverage-functions=100",
    "test:junit": "node --test --test-reporter=junit",
    "start": "node src/server.js"
  },
  "license": "MIT"
}


